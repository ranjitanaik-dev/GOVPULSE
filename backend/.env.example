# GovPulse Backend Environment Configuration (Template / Example)
# Copy this file to `backend/.env` and adjust settings as appropriate.

# MongoDB Connection
# Option A: Local MongoDB Community Server
MONGODB_URI=mongodb://127.0.0.1:27017

# Option B: MongoDB Atlas (Free Tier or Dedicated Cluster)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/govpulse_db?retryWrites=true&w=majority

# Target Database Name
MONGODB_DB_NAME=govpulse_db

# Connection Timeouts (in milliseconds)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CONNECT_TIMEOUT_MS=5000

# Feature Flags
USE_MONGODB_SOURCE=false
