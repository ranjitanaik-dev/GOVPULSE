# ==============================================================================
# GovPulse - Git Ignore Configuration
# ==============================================================================

# Environment & Secrets (STRICT: Never commit actual environment files)
.env
.env.*
*.env
backend/.env
frontend/.env
!backend/.env.example
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Spark / Hadoop / Temporary Execution Storage
derby.log
metastore_db/
spark-warehouse/
data/spark_temp/
data/spark_warehouse/
data/test_raw/

# Data Directories (Raw uploads, processed, quarantine, generated reports)
data/raw/*
data/processed/*
data/quarantine/*
data/reports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/quarantine/.gitkeep
!data/reports/.gitkeep

# Databases (SQLite local development & test instances)
*.db
*.sqlite
*.sqlite3
data/*.db
data/govpulse.db
data/test_migration.db

# Node / React Frontend
node_modules/
frontend/node_modules/
frontend/dist/

# Scratch & Temporary Diagnostic Scripts
scratch/

# IDE, OS & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/
